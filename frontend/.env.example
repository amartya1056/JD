# Frontend build-time config (Vite). Copy to `.env` and adjust as needed.

# Base URL the browser calls for the API.
# - In dev, leave as /api and let vite.config.js proxy to the backend.
# - In production (e.g. served behind the same domain), set the full API origin.
VITE_API_BASE=/api

# Where the dev proxy forwards /api requests (backend origin).
VITE_API_TARGET=http://127.0.0.1:8000
