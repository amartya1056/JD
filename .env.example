# JobGuard configuration (copy to `.env`). All values have sensible defaults;
# override only what you need. Consumed by jobguard/config.py.

# --- Model / paths ---
JOBGUARD_MODELS_DIR=./models
JOBGUARD_DATA_DIR=./data
JOBGUARD_MODEL_BUNDLE=ensemble_latest.joblib

# --- Verdict thresholds (probability the posting is REAL) ---
JOBGUARD_REAL_THRESHOLD=0.80        # >= this -> REAL
JOBGUARD_FAKE_THRESHOLD=0.50        # <  this -> FAKE ; between -> SUSPICIOUS

# --- Ensemble weighting fallback (when meta-learner absent) ---
JOBGUARD_TABULAR_WEIGHT=0.6
JOBGUARD_TEXT_WEIGHT=0.4

# --- BERT toggle: auto | on | off ---
JOBGUARD_USE_BERT=auto

# --- Scraper ---
JOBGUARD_SCRAPE_TIMEOUT=15

# --- Database ---
# SQLite (default, zero infra):
JOBGUARD_DATABASE_URL=sqlite:///./jobguard.db
# Postgres (docker-compose provides this):
# JOBGUARD_DATABASE_URL=postgresql+psycopg://jobguard:jobguard@db:5432/jobguard

# --- API ---
JOBGUARD_CORS_ORIGINS=http://localhost:5173,http://localhost:3000
JOBGUARD_RATE_LIMIT=30

# --- Groq LLM (natural-language "Analyst Summary") ---
# Get a key at https://console.groq.com/keys. Kept server-side only; never
# exposed to the browser. Leave blank to disable (deterministic explanation
# still shown). Store the REAL key in .env (gitignored), not here.
JOBGUARD_GROQ_API_KEY=
JOBGUARD_GROQ_MODEL=openai/gpt-oss-20b
JOBGUARD_USE_LLM=on
JOBGUARD_GROQ_TIMEOUT=12

# --- Serving the DistilBERT ensemble (optional) ---
# Point the bundle at the BERT model and torch is preloaded automatically.
# JOBGUARD_MODEL_BUNDLE=ensemble_bert.joblib
# JOBGUARD_SERVE_BERT=on          # or just include "bert" in the bundle name
# KMP_DUPLICATE_LIB_OK=TRUE       # Windows: allow torch+xgboost OpenMP to coexist
